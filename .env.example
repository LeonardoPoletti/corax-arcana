# Copy this file to .env and adjust values for your environment.
# .env is gitignored — never commit real credentials.

# Which environment this stack is running as: dev, staging, or prod.
ENVIRONMENT=dev

# PostgreSQL container credentials (used by the db service).
POSTGRES_USER=kybercorax
POSTGRES_PASSWORD=change-me
POSTGRES_DB=corax_arcana

# Full connection string the backend app uses to reach PostgreSQL.
# Host is "db" — the service name in docker-compose.yml, not localhost.
DATABASE_URL=postgresql://kybercorax:change-me@db:5432/corax_arcana

# Redis connection string the backend app uses for caching.
REDIS_URL=redis://redis:6379